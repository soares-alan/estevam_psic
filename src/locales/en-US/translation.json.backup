  "areas": {
  "title": "Psychoanalytic Methodology",
    "subtitle": "Personalized approaches for different needs",
    "description": "The psychoanalytic approach offers a space to explore the hidden meanings behind thoughts, behaviors, and dreams, providing a path to deep self-knowledge.",
    "quote": "The ego is not master in its own house",
    "author": "Sigmund Freud",
    "scheduleButton": "Schedule a session",
    "principles": {
      "listening": {
        "title": "Analytical Listening",
        "description": "Attentive and judgment-free listening, focused not only on what is said but also on what remains unspoken."
      },
      "unconscious": {
        "title": "Unconscious",
        "description": "Exploration of contents beyond immediate consciousness that significantly influence our behaviors."
      },
      "transferencia": {
        "title": "Transference",
        "description": "The therapeutic process as a space to relive and reframe relationships and feelings from the past."
      },
      "singularity": {
        "title": "Singularity",
        "description": "Recognition of each individual's unique history and adaptation of the therapeutic process to this singularity."
      }
    },
    "list": {
